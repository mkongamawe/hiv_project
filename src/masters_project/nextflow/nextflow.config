// --- Default Parameters --
params {
    cohort            = "training_ucsd"
    reads             = "${launchDir}/data/fastq/*.fastq.gz"
    outdir            = "${launchDir}/results"
    transcriptome     = "${launchDir}/data/reference/refdata-gex-GRCh38-2024-A"
    singularity_cache = "${launchDir}/singularity_cache"
    conda_cache       = "${launchDir}/conda_cache"

    email             = false
}

// Redirect work directory to the root
workDir = "${launchDir}/work"

// --- Global Process Defaults ---
process {
    // Error strategy: retry transient memory/timeout failures 
    errorStrategy = { task.exitStatus in ((137..140) + 143) ? 'retry' : 'finish' }
    maxRetries = 2

    withLabel: 'process_single' {
        cpus    = 1
        memory  = { 4.GB * task.attempt }
        time    = { 2.h  * task.attempt }
    }
    withLabel: 'process_low' {
        cpus    = 2
        memory  = { 4.GB * task.attempt }
        time    = { 2.h  * task.attempt }
    }
    withLabel: 'process_high' {
        cpus    = 8
        memory  = 64.GB
        time    = 24.h
        queue   = 'highmem'
    }
}

// --- Execution Profiles ---
profiles {
    
    // Profile 1: Laptop Execution
    laptop {
        process.executor        = 'local'

        executor {
            cpus   = 6
            memory = '12 GB'
        }

        singularity {
            enabled    = true
            autoMounts = true
            cacheDir   = params.singularity_cache
        }
    }

    // Profile 2: HPC cluster
    hpc {
        process.executor         = 'slurm'
        process.queue            = 'highmem' // To be changed to low resource HPC node

        executor {
            queueSize       = 5
            submitRateLimit = '10 sec'
        }

        singularity {
            enabled    = true
            autoMounts = true
            cacheDir   = params.singularity_cache
        }

        conda {
            enabled = true
            useMamba = true
            cacheDir = params.conda_cache
        }
    }
}

// --- Execution Reports and Telemetry ---
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}

notification {
    enabled = params.email ? true : false
    to      = params.email
}