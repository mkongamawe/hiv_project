// nextflow.config

manifest {
    diagram = 'docs/images/metro_map.svg' // Metro map rendered from assets/metro_map.mmd with nf-metro
}

params {
    // --- Workflow Mode & Cohort ---
    mode              = "count" // Options: 'count' or 'multi'
    cohort            = "training_ucsd"
    outdir            = "${launchDir}/results"

    // --- Input Options ---
    // Option A: Start from raw Illumina BCL directory
    bcl_dir           = null    // e.g., "/path/to/bcl_run_folder"
    bcl_samplesheet   = null    // e.g., "/path/to/SampleSheet.csv"

    // Option B: Start from FASTQ files
    reads             = "${launchDir}/data/${params.cohort}/fastq/*.{fastq,fq}.gz"
    
    // Optional SRA/Run-to-BioSample grouping CSV (Columns: Run,BioSample)
    metadata          = null    // Set to "${launchDir}/SraRunTable.csv" when grouping SRRs

    // Required for --mode 'multi' (Columns: pool_id,sample_id,probe_barcode_ids)
    multi_samples     = "${launchDir}/data/${params.cohort}/multi_samples.csv"

    // --- Reference Files ---
    transcriptome     = "${launchDir}/data/reference/refdata-gex-GRCh38-2024-A"
    probe_set         = "${launchDir}/data/reference/Chromium_Human_Transcriptome_Probe_Set_v2.0_GRCh38-2024-A.csv"
    feature_ref       = null // Required for Antibody capture Libraries in multi mode

    // --- Tool & QC Toggles ---
    create_bam        = false
    skip_fastqc       = false
    skip_multiqc      = false

    // --- Infrastructure & Notifications ---
    singularity_cache = "${launchDir}/singularity_cache"
    conda_cache       = "${launchDir}/conda_cache"
    email             = false
}

workDir = "${launchDir}/work"

// --- Global Process Resource Labels & Error Handling ---
process {
    errorStrategy = { task.exitStatus in [137, 138, 139, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2
    resourceLimits = [ cpus: 32, memory: 256.GB, time: 72.h ]

    withLabel: 'process_single' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withLabel: 'process_low' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = { 64.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }

    // Skip samples that fail Cell Ranger (e.g. bad FASTQs) instead of stopping the run,
    // so the remaining samples and MultiQC still complete. Resource errors are still retried.
    withName: 'CELLRANGER_COUNT|CELLRANGER_MULTI' {
        errorStrategy = { task.exitStatus in [137, 138, 139, 140, 143] ? 'retry' : 'ignore' }
    }
}

// --- Execution Profiles ---
profiles {

    // Profile 1: Local Laptop Testing ( best paired with -stub )
    laptop {
        process.executor = 'local'
        executor {
            cpus   = 6
            memory = '12 GB'
        }
        singularity {
            enabled    = true
            autoMounts = true
            cacheDir   = params.singularity_cache
        }
        process {
            withName: 'FASTQC'  { container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0' }
            withName: 'MULTIQC' { container = 'quay.io/biocontainers/multiqc:1.25.1--pyhdfd78af_0' }
        }
    }

    // Profile 2: University HPC Cluster (Slurm + Native Modules + Container Fallback)
    hpc {
        process.executor = 'slurm'
        process.queue    = 'longrun' // Default low-resource queue

        executor {
            queueSize       = 5
            submitRateLimit = '10 sec'
        }

        singularity {
            enabled    = true
            autoMounts = true
            cacheDir   = params.singularity_cache
        }

        process {
            withLabel: 'process_high' {
                queue = 'highmem'
            }
            withName: 'BCL_CONVERT' {
                module = 'bcl-convert/4.2.4'
            }
            withName: 'CELLRANGER_COUNT|CELLRANGER_MULTI' {
                module = 'cellranger/10.0.0'
            }
            withName: 'FASTQC' {
                // container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
                module = 'fastqc/0.13.0'
            }
            withName: 'MULTIQC' {
                // container = 'quay.io/biocontainers/multiqc:1.25.1--pyhdfd78af_0'
                module = 'multiqc/1.35-py313'
            }
        }
    }
}

// --- Execution Telemetry, Reports & Automated Pipeline Diagram ---
timeline {
    enabled   = true
    file      = "${params.outdir}/${params.cohort}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/${params.cohort}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/${params.cohort}/pipeline_info/execution_trace.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.outdir}/${params.cohort}/pipeline_info/pipeline_dag.html"
    overwrite = true
}

notification {
    enabled = params.email ? true : false
    to      = params.email
}