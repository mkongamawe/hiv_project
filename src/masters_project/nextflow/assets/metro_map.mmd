graph LR
    subgraph sra_in [SRA FASTQs - multi planned]
        sra[SRA _1/_2 FASTQs]
        group[Group runs by BioSample]
        stage[STAGE_FASTQ]
        sra -->|count,multi| group
        group -->|count,multi| stage
    end

    subgraph demux [BCL demultiplexing]
        bcl[BCL folder]
        bclconv[BCL_CONVERT]
        undet[Drop Undetermined]
        bcl -->|count,multi| bclconv
        bclconv -->|count,multi| undet
    end

    subgraph fastq_in [Illumina-named FASTQs]
        fq[S1_L001_R1_001 FASTQs]
    end

    subgraph raw_qc [Read QC]
        fastqc[FASTQC]
    end

    subgraph align [Cell Ranger]
        crcount[CELLRANGER_COUNT]
        merge[Merge gex + ab per pool]
        crmulti[CELLRANGER_MULTI]
        merge -->|multi| crmulti
    end

    subgraph report [Report]
        multiqc[MULTIQC]
    end

    stage -->|count,multi| fastqc
    undet -->|count,multi| fastqc
    fq -->|count,multi| fastqc

    fastqc -->|count| crcount
    fastqc -->|multi| merge

    crcount -->|count| multiqc
    crmulti -->|multi| multiqc
